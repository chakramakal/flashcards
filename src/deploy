#!/bin/sh
# usage: deploy [OUTDIR]
# Publish OUTDIR/release to the GitHub releases page of origin.
# Run release first, and push the commit before deploying.
# Environment: TAG, GH_USER, TOKEN (encrypted token file).

set -e

die() {
	printf '%s: %s\n' "$(basename "$0")" "$*" >&2
	exit 1
}

log() {
	printf '%s\n' "$*" >&2
}

tools() {
	for cmd in git gh gpg; do
		command -v "$cmd" >/dev/null || die "missing tool: $cmd"
	done
}

files() {
	[ -f "$rel/SHA256SUMS.asc" ] || die "no release in $rel (run release)"
	tag=${TAG:-$(cat "$rel/tag" 2>/dev/null || true)}
	[ -n "$tag" ] || die "no tag (run release)"
	git rev-parse -q --verify "refs/tags/$tag" >/dev/null ||
		die "no tag $tag (run release)"
}

insync() {
	[ -z "$(git status --porcelain)" ] || die "uncommitted changes"
	up=$(git rev-parse '@{u}') || die "no upstream branch"
	[ "$(git rev-parse HEAD)" = "$up" ] ||
		die "HEAD differs from upstream: push or pull first"
	[ "$(git rev-list -n 1 "$tag")" = "$up" ] ||
		die "tag $tag is not at HEAD (run release again)"
}

account() {
	url=$(git remote get-url origin) || die "no origin remote"
	user=${GH_USER:-$(printf '%s' "$url" |
		sed -E 's|.*github\.com[:/]([^/]+)/.*|\1|')}
	token=${TOKEN:-$HOME/.local/share/$user/github-token.gpg}
	[ -f "$token" ] || die "token not found: $token"
}

upload() {
	set -- "$rel"/*.apkg "$rel/SHA256SUMS" "$rel/SHA256SUMS.asc"
	if gh release view "$tag" >/dev/null 2>&1; then
		log "replacing files in release $tag"
		gh release upload "$tag" "$@" --clobber
		return 0
	fi
	log "creating release $tag"
	gh release create "$tag" "$@" --verify-tag \
		--title "$tag" --notes "Anki decks, $tag"
}

main() {
	out=${1:-out}
	rel=$out/release
	tools
	files
	insync
	account
	GPG_TTY=$(tty || true)
	export GPG_TTY
	log "tag $tag, account $user"
	git push origin "$tag"
	GH_TOKEN=$(gpg --pinentry-mode loopback -q -d "$token") ||
		die "could not decrypt $token"
	export GH_TOKEN
	upload
	log "publishing release $tag"
	gh release edit "$tag" --draft=false
}

main "$@"
